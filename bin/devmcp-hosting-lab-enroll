#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Central administrator opt-in for the exact 3 case hosting lab deployments.
 *
 * Usage: sudo php bin/devmcp-hosting-lab-enroll --apply < consent.json
 * Consent JSON: {"machine_id":"32 lowercase hex","approval":"ENROLL_CASE_HOSTING_LAB"}
 * This does NOT deploy apps, enable queue polling, or modify a router.
 */
require dirname(__DIR__) . '/vendor/autoload.php';

use Cowprod\DevMcp\Distributed\Admin\HostingLabEnrollment;
use Cowprod\DevMcp\Distributed\Registry\DatabaseConnection;

try {
    if (!function_exists('posix_geteuid') || posix_geteuid() !== 0
        || $argc !== 2 || $argv[1] !== '--apply') {
        throw new RuntimeException('Local central root approval required');
    }
    $raw = stream_get_contents(STDIN, 513);
    if (!is_string($raw) || $raw === '' || strlen($raw) > 512) {
        throw new InvalidArgumentException('Invalid central hosting lab consent size');
    }
    $consent = json_decode($raw, true, 4, JSON_THROW_ON_ERROR);
    if (!is_array($consent) || array_is_list($consent)
        || array_keys($consent) !== ['machine_id', 'approval']
        || ($consent['approval'] ?? null) !== 'ENROLL_CASE_HOSTING_LAB') {
        throw new InvalidArgumentException('Explicit central hosting lab consent missing');
    }

    // The queue's root-owned opt-in is a prerequisite, not a side effect.
    // No paths, credentials or SQL expressions are accepted from stdin.
    $path = '/etc/devmcp-admin/distributed.php';
    clearstatcache(true, $path);
    $file = @lstat($path);
    if (!is_array($file) || ($file['mode'] & 0170000) !== 0100000
        || $file['uid'] !== 0 || ($file['mode'] & 0022) !== 0
        || $file['nlink'] !== 1 || $file['size'] < 1 || $file['size'] > 65536) {
        throw new RuntimeException('Untrusted central configuration');
    }
    foreach (['/etc', '/etc/devmcp-admin'] as $directory) {
        $meta = @lstat($directory);
        if (!is_array($meta) || ($meta['mode'] & 0170000) !== 0040000
            || $meta['uid'] !== 0 || ($meta['mode'] & 0022) !== 0) {
            throw new RuntimeException('Untrusted central configuration path');
        }
    }
    $config = require $path;
    if (!is_array($config)
        || ($config['remote_hosting_queue_enabled'] ?? false) !== true) {
        throw new RuntimeException('Central hosting queue not independently opted in');
    }
    $db = DatabaseConnection::connect(
        (string) ($config['dsn'] ?? ''),
        (string) ($config['writer_username'] ?? ''),
        (string) ($config['writer_password'] ?? '')
    );
    $result = HostingLabEnrollment::enroll($db, $consent['machine_id']);
    echo json_encode($result, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES) . "\n";
    exit(0);
} catch (Throwable $error) {
    // Never emit connection strings, credentials or SQL details.
    fwrite(STDERR, 'Central hosting lab enrollment denied: ' . get_class($error) . "\n");
    exit(1);
}
