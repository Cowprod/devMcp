#!/usr/bin/env php
<?php
declare(strict_types=1);

$directory = '/var/lib/devmcp';
$request = $directory . '/update-request';
$results = '/var/lib/devmcp-update-status';

if ($argc === 3 && $argv[1] === '--status' && preg_match('/\A[a-f0-9]{32}\z/', $argv[2]) === 1) {
    $id = $argv[2];
    $file = "$results/$id.json";
    if (!is_file($file)) {
        echo json_encode(['update_id' => $id, 'status' => 'unconfirmed'], JSON_THROW_ON_ERROR), "\n";
        exit(0);
    }
    $json = (string) file_get_contents($file, false, null, 0, 4096);
    // Earlier versions wrote a literal backslash-n after the JSON object.
    if (str_ends_with($json, '\n')) {
        $json = substr($json, 0, -2);
    }
    $status = json_decode($json, true);
    if (($status['update_id'] ?? null) !== $id) {
        fwrite(STDERR, "Invalid persisted update result\n");
        exit(1);
    }
    echo json_encode($status, JSON_THROW_ON_ERROR), "\n";
    exit(0);
}
if ($argc !== 1) {
    fwrite(STDERR, "Usage: devmcp-update-request [--status <update-id>]\n");
    exit(2);
}
if (!is_dir($directory) || !is_writable($directory)) {
    fwrite(STDERR, "Update request directory is not writable\n");
    exit(1);
}
if (file_exists($request) || is_link($request)) {
    fwrite(STDERR, "An update request is already queued\n");
    exit(1);
}

// Trust this checkout for this Git invocation only. Resolve the upstream SHA
// before accepting a request, and use no caller-supplied command arguments.
exec('GIT_TERMINAL_PROMPT=0 /usr/bin/git -c safe.directory=/opt/devmcp -C /opt/devmcp ls-remote --exit-code origin refs/heads/main 2>/dev/null', $lines, $exitCode);
if ($exitCode !== 0 || count($lines) !== 1
    || preg_match('/\A([a-f0-9]{40})\trefs\/heads\/main\z/', $lines[0], $match) !== 1) {
    fwrite(STDERR, "Cannot resolve requested revision\n");
    exit(1);
}
$requested = $match[1];
$id = bin2hex(random_bytes(16));
$contents = "$id $requested\n";
$staged = tempnam($directory, '.update-request.');
if ($staged === false) {
    fwrite(STDERR, "Could not stage update request\n");
    exit(1);
}
try {
    // Publish the complete request atomically, without replacing a concurrent request.
    $queued = file_put_contents($staged, $contents) === strlen($contents) && @link($staged, $request);
} finally {
    unlink($staged);
}
if (!$queued) {
    fwrite(STDERR, "Could not queue update request (another request may already be queued)\n");
    exit(1);
}
echo json_encode(['update_id' => $id, 'status' => 'queued', 'requested_revision' => $requested], JSON_THROW_ON_ERROR), "\n";
