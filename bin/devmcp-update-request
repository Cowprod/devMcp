#!/usr/bin/env php
<?php
declare(strict_types=1);
// Write a bounded request in the worker-owned state directory.
// The root-owned updater polls this file through systemd, never via sudo.
$directory = '/var/lib/devmcp';
$request = $directory . '/update-request';
if (!is_dir($directory) || !is_writable($directory)) {
    fwrite(STDERR, "Update request directory is not writable\n");
    exit(1);
}
if (is_link($request) || (file_exists($request) && !is_file($request))) {
    fwrite(STDERR, "Invalid update request path\n");
    exit(1);
}
if (file_put_contents($request, gmdate('c') . "\n", LOCK_EX) === false) {
    fwrite(STDERR, "Could not queue update request\n");
    exit(1);
}
echo "Update queued; systemd checks within one minute.\n";
