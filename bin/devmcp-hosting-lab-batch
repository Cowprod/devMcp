#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Central root-only batch enqueue; NEVER available as an HTTP/MCP action.
 *
 * --prepare queues the three immutable demo revisions atomically.
 * --activate refuses unless the latest preparation of EACH revision has
 * succeeded. It returns one unique activation nonce per runtime.
 * --prepare-name/--activate-name use a separately approved exact machine name.
 * They never grant agent permissions or relax the three-demo transaction.
 *
 * Example stdin:
 * {"machine_id":"<32 hex>","revision":"<40 hex>","approval":"PREPARE_CASE_HOSTING_LAB"}
 */
require dirname(__DIR__) . '/vendor/autoload.php';

use Cowprod\DevMcp\Distributed\Admin\HostingLabBatchEnqueue;
use Cowprod\DevMcp\Distributed\Admin\HostingLabBatchConsent;
use Cowprod\DevMcp\Distributed\Admin\HostingLabMachineResolver;
use Cowprod\DevMcp\Distributed\Registry\DatabaseConnection;

try {
    if (!function_exists('posix_geteuid') || posix_geteuid() !== 0 || $argc !== 2) {
        throw new RuntimeException('Central root lab batch command required');
    }
    $raw = stream_get_contents(STDIN, 513);
    if (!is_string($raw)) {
        throw new InvalidArgumentException('Invalid central hosting lab batch consent');
    }
    $consent = HostingLabBatchConsent::parse($argv[1], $raw);

    $path = '/etc/devmcp-admin/distributed.php';
    foreach (['/etc', '/etc/devmcp-admin'] as $directory) {
        clearstatcache(true, $directory);
        $meta = @lstat($directory);
        if (!is_array($meta) || ($meta['mode'] & 0170000) !== 0040000
            || $meta['uid'] !== 0 || ($meta['mode'] & 0022) !== 0) {
            throw new RuntimeException('Untrusted central hosting config path');
        }
    }
    clearstatcache(true, $path);
    $file = @lstat($path);
    if (!is_array($file) || ($file['mode'] & 0170000) !== 0100000
        || $file['uid'] !== 0 || ($file['mode'] & 0022) !== 0
        || $file['nlink'] !== 1 || $file['size'] < 1 || $file['size'] > 65536) {
        throw new RuntimeException('Untrusted central hosting config');
    }
    $config = require $path;
    if (!is_array($config)
        || ($config['remote_hosting_queue_enabled'] ?? false) !== true) {
        throw new RuntimeException('Central hosting queue not opted in');
    }
    $db = DatabaseConnection::connect(
        (string) ($config['dsn'] ?? ''),
        (string) ($config['writer_username'] ?? ''),
        (string) ($config['writer_password'] ?? '')
    );
    // Resolve exact name before any queue write. BatchEnqueue still locks
    // the machine and checks active enrollment/grants inside its SQL transaction.
    $machineId = $consent['machine_name'] !== null
        ? HostingLabMachineResolver::resolve($db, $consent['machine_name'])
        : $consent['machine_id'];
    $result = HostingLabBatchEnqueue::enqueue(
        $db, $machineId, $consent['revision'], $consent['phase']
    );
    echo json_encode($result, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES) . "\n";
    exit(0);
} catch (Throwable $error) {
    fwrite(STDERR, 'Central lab batch enqueue rejected: ' . get_class($error) . "\n");
    exit(1);
}
