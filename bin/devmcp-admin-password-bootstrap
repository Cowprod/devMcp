#!/usr/bin/env php
<?php
declare(strict_types=1);
try{
 $path='/run/devmcp-admin-bootstrap-password';
 if($argc!==1||is_link($path)||!is_file($path)||fileowner($path)!==0||!is_readable($path))throw new RuntimeException('Bootstrap credential unavailable');
 $value=json_decode(file_get_contents($path),true,8,JSON_THROW_ON_ERROR);
 if(($value['username']??null)!=='admin'||!is_string($value['password']??null))throw new RuntimeException('Invalid bootstrap credential');
 echo json_encode($value,JSON_THROW_ON_ERROR),"\n";
}catch(Throwable $error){fwrite(STDERR,$error->getMessage()."\n");exit(1);}
