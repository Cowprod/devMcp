<?php

declare(strict_types=1);

/**
 * Local root-only entrypoint for the hosting lab.
 *
 * Not installed as sudoers, setuid, systemd, an agent action or MCP endpoint.
 * A future installer must separately grant an exact argv and the local policy
 * must explicitly approve the machine and deployment. This executable never
 * touches routing, NAT, firewall, WAN/LAN interfaces or router services.
 *
 * Usage: php bin/devmcp-hosting-root prepare-all|refresh|prepare|install-unit|activate-initial|abort-initial|switch|rollback|settle-rollback < request.json
 * Request: exact JSON object with deployment_id, machine_id, project_id,
 * revision and (for switch/rollback/settle-rollback only) operation_id.
 */
use Cowprod\DevMcp\Project\RemoteHostingGitRefresh;
use Cowprod\DevMcp\Project\RemoteHostingLocalPreparation;
use Cowprod\DevMcp\Project\RemoteHostingInitialActivation;
use Cowprod\DevMcp\Project\RemoteHostingReleaseStager;
use Cowprod\DevMcp\Project\RemoteHostingReleaseSwap;
use Cowprod\DevMcp\Project\RemoteHostingUnitInstaller;

// The source checkout uses Composer. On a remote host the immutable,
// root-owned bundle is intentionally self-contained and has no vendor/.
// A fixed-namespace autoloader loads ONLY the approved bundled classes.
$composerAutoload = dirname(__DIR__) . '/vendor/autoload.php';
if (is_file($composerAutoload) && !is_link($composerAutoload)) {
    require $composerAutoload;
} else {
    $projectDir = __DIR__ . '/Project';
    $directory = @lstat($projectDir);
    if (!is_array($directory) || ($directory['mode'] & 0170000) !== 0040000
        || $directory['uid'] !== 0 || ($directory['mode'] & 0022) !== 0) {
        throw new RuntimeException('Untrusted hosting bundle directory');
    }
    spl_autoload_register(static function (string $name) use ($projectDir): void {
        $prefix = 'Cowprod\\DevMcp\\Project\\';
        if (!str_starts_with($name, $prefix)) {
            return;
        }
        $class = substr($name, strlen($prefix));
        if (preg_match('/^RemoteHosting[A-Za-z0-9]+$/D', $class) !== 1) {
            throw new RuntimeException('Unapproved hosting bundle class');
        }
        $path = $projectDir . '/' . $class . '.php';
        $meta = @lstat($path);
        if (!is_array($meta) || ($meta['mode'] & 0170000) !== 0100000
            || ($meta['mode'] & 07777) !== 0644
            || $meta['uid'] !== 0 || $meta['nlink'] !== 1) {
            throw new RuntimeException('Untrusted hosting bundle source');
        }
        require_once $path;
    });
}

function hostingRootRequest(string $json, string $operation): array
{
    if ($json === '' || strlen($json) > 4096) {
        throw new InvalidArgumentException('Invalid hosting input size');
    }
    $data = json_decode($json, true, 8, JSON_THROW_ON_ERROR);
    if (!is_array($data) || array_is_list($data)) {
        throw new InvalidArgumentException('Hosting request must be an object');
    }
    $expected = ['deployment_id', 'machine_id', 'project_id', 'revision'];
    if (!in_array($operation, ['prepare-all', 'refresh', 'prepare', 'install-unit'], true)) {
        $expected[] = 'operation_id';
    }
    if ($operation === 'commit-initial') {
        $expected[] = 'proof';
    }
    $keys = array_keys($data);
    sort($keys);
    sort($expected);
    if ($keys !== $expected) {
        throw new InvalidArgumentException('Unexpected hosting request fields');
    }
    foreach (['deployment_id' => 32, 'machine_id' => 32, 'revision' => 40] as $key => $length) {
        if (!is_string($data[$key]) || preg_match('/^[a-f0-9]{' . $length . '}$/D', $data[$key]) !== 1) {
            throw new InvalidArgumentException('Invalid hosting request identifier');
        }
    }
    if (!is_string($data['project_id'])
        || preg_match('/^[a-z0-9][a-z0-9_-]{0,63}$/D', $data['project_id']) !== 1) {
        throw new InvalidArgumentException('Invalid hosting project');
    }
    if (!in_array($operation, ['prepare-all', 'refresh', 'prepare', 'install-unit'], true)
        && (!is_string($data['operation_id'])
            || preg_match('/^[a-f0-9]{32}$/D', $data['operation_id']) !== 1
            || $data['operation_id'] === str_repeat('0', 32))) {
        throw new InvalidArgumentException('Invalid hosting operation nonce');
    }
    if ($operation === 'commit-initial'
        && (!is_array($data['proof']) || array_is_list($data['proof']))) {
        throw new InvalidArgumentException('Invalid signed health proof');
    }
    return $data;
}

function hostingRootMain(array $argv): int
{
    // The name and argument count are both fixed. No arbitrary commands,
    // dynamic PHP functions, shell strings or caller-provided paths.
    $operation = $argv[1] ?? '';
    if (count($argv) !== 2 || !in_array($operation, ['prepare-all', 'refresh', 'prepare', 'install-unit', 'activate-initial', 'abort-initial', 'switch', 'rollback', 'settle-rollback', 'commit-initial'], true)) {
        throw new InvalidArgumentException('Usage: devmcp-hosting-root prepare|install-unit|switch|rollback|settle-rollback');
    }
    if (!function_exists('posix_geteuid') || posix_geteuid() !== 0) {
        throw new RuntimeException('Hosting executor requires local root');
    }
    $input = stream_get_contents(STDIN, 4097);
    if (!is_string($input) || strlen($input) > 4096) {
        throw new InvalidArgumentException('Hosting request exceeds limit');
    }
    $request = hostingRootRequest($input, $operation);
    $nonce = $request['operation_id'] ?? null;
    $proof = $request['proof'] ?? null;
    unset($request['operation_id'], $request['proof']);

    // Each primitive independently checks the local root-owned policy,
    // enrolled identity, workspace and Git/release evidence. Do not treat
    // this dispatcher as a completed service activation transaction.
    $result = match ($operation) {
        'prepare-all' => RemoteHostingLocalPreparation::run($request),
        'refresh' => RemoteHostingGitRefresh::refresh($request),
        'prepare' => RemoteHostingReleaseStager::prepare($request),
        'install-unit' => RemoteHostingUnitInstaller::install($request),
        'activate-initial' => RemoteHostingInitialActivation::startPending($request, $nonce),
        'abort-initial' => RemoteHostingInitialActivation::abortPending($request, $nonce),
        'switch' => RemoteHostingReleaseSwap::switch($request, $nonce),
        'rollback' => RemoteHostingReleaseSwap::rollback($request, $nonce),
        'settle-rollback' => RemoteHostingReleaseSwap::settleRollback($request, $nonce),
        'commit-initial' => RemoteHostingReleaseSwap::commitInitial($request, $nonce, $proof),
    };
    echo json_encode([
        'operation' => $operation,
        'result' => $result,
        'service_verified' => false,
        'peer_health_verified' => $operation === 'commit-initial' && ($result['peer_health_verified'] ?? false) === true,
        'deployment_complete' => $operation === 'commit-initial' && ($result['deployment_complete'] ?? false) === true,
    ], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES) . "\n";
    return 0;
}

try {
    exit(hostingRootMain($argv));
} catch (Throwable $error) {
    // Fail closed without echoing paths, policy contents or request secrets.
    fwrite(STDERR, 'Hosting operation rejected: ' . get_class($error) . "\n");
    exit(1);
}
