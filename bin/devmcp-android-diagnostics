#!/usr/bin/env php
<?php
declare(strict_types=1);
require dirname(__DIR__).'/vendor/autoload.php';
use Cowprod\DevMcp\Android\{Diagnostics,DiagnosticException};
use Cowprod\DevMcp\Runtime\RuntimeFactory;
use Cowprod\DevMcp\Mcp\RemoteTools;
try{
    if($argc<4||$argc>7)throw new DiagnosticException('invalid_parameters');
    [$script,$projectId,$operation,$device]=$argv;$action='android.'.$operation;
    if(!in_array($action,Diagnostics::ACTIONS,true))throw new DiagnosticException('unknown_action');
    $config=require(getenv('DEVMCP_CONFIG')?:'/etc/devmcp/global.php');
    $runtime=RuntimeFactory::fromConfig($config,dirname(__DIR__).'/var');$project=$runtime->projects->get($projectId);
    if(realpath(getcwd())!==$project->root)throw new DiagnosticException('invalid_project_context');
    $declared=$project->getAction($action);
    $arguments=['device'=>$device];
    if(in_array($operation,['files','logcat'],true)){
        if($argc!==6||!ctype_digit($argv[5]))throw new DiagnosticException('invalid_parameters');
        $arguments+=[$operation==='files'?'location':'filter'=>$argv[4],$operation==='files'?'limit':'lines'=>(int)$argv[5]];
    }elseif($operation==='log_file'){
        if($argc!==7||!ctype_digit($argv[4]))throw new DiagnosticException('invalid_parameters');
        $arguments['bytes']=(int)$argv[4];
        $arguments['package']=$argv[5];
        $arguments['filename']=$argv[6];
    }elseif($argc!==4)throw new DiagnosticException('invalid_parameters');
    $declared->normalizeArguments($arguments);
    $db=RemoteTools::fromConfig($config)?->sqlProjectConfiguration();
    if($db===null||!$db->isReady())throw new DiagnosticException('registry_unavailable');
    $raw=$db->load()['projects'][$projectId]??null;
    if(!is_array($raw))throw new DiagnosticException('invalid_project_context');
    $service=new Diagnostics($raw['android_diagnostics']??[]);
    unset($arguments['device']);$result=$service->execute($action,$device,$arguments);
    echo json_encode($result,JSON_THROW_ON_ERROR|JSON_INVALID_UTF8_SUBSTITUTE|JSON_UNESCAPED_SLASHES),"\n";
}catch(DiagnosticException $e){echo json_encode(['status'=>$e->reason,'read_only'=>true],JSON_THROW_ON_ERROR),"\n";exit(1);}
catch(\InvalidArgumentException){echo '{"status":"invalid_parameters","read_only":true}',"\n";exit(1);}
catch(Throwable $e){fwrite(STDERR,'android-diagnostics: '.get_class($e)."\n");echo '{"status":"diagnostic_unavailable","read_only":true}',"\n";exit(1);}
