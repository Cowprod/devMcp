#!/usr/bin/env php
<?php
declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';
try {
    if ($argc !== 4) {
        throw new InvalidArgumentException('Usage: devmcp-project-create-remote PROJECT MACHINE DESCRIPTION');
    }
    $config = require (getenv('DEVMCP_CONFIG') ?: '/etc/devmcp/global.php');
    $runtime = \Cowprod\DevMcp\Runtime\RuntimeFactory::fromConfig($config, dirname(__DIR__) . '/var');
    $result = $runtime->tools->projectCreateRemote($argv[1], $argv[3], $argv[2], 'CREATE_PROJECT');
    echo json_encode($result, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), "\n";
} catch (Throwable $error) {
    fwrite(STDERR, 'Remote creation failed: ' . $error->getMessage() . "\n");
    exit(1);
}
