#!/usr/bin/env php
<?php

declare(strict_types=1);

use Cowprod\DevMcp\Project\CowprodPhpSocle;

require dirname(__DIR__).'/vendor/autoload.php';
if ($argc !== 5 || !in_array($argv[1], ['init', 'update'], true)) {
    fwrite(STDERR, "Usage: devmcp-socle-php init|update <referenciel> <sha> <projet>\n");
    exit(2);
}
try {
    $oSocle = new CowprodPhpSocle();
    $aFichiers = $oSocle->lire($argv[2], $argv[3]);
    $oSocle->verifier($aFichiers);
    $oSocle->appliquer($argv[4], $aFichiers, $argv[1] === 'update');
    echo 'Socle vérifié et appliqué '.$argv[3].PHP_EOL;
} catch (Throwable $oErreur) {
    fwrite(STDERR, $oErreur->getMessage().PHP_EOL);
    exit(1);
}
