#!/usr/bin/env python3
import argparse
import sys
import time

import serial


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Read a bounded serial capture.")
    parser.add_argument("port")
    parser.add_argument("baud", type=int)
    parser.add_argument("seconds", type=int)
    return parser.parse_args()


def main() -> int:
    args = parse_args()

    if not (args.port.startswith("/dev/ttyACM") or args.port.startswith("/dev/ttyUSB")):
        print("invalid serial device", file=sys.stderr)
        return 2
    if args.baud not in {9600, 19200, 38400, 57600, 115200, 230400, 460800, 921600}:
        print("unsupported baud rate", file=sys.stderr)
        return 2
    if args.seconds < 1 or args.seconds > 30:
        print("capture duration must be between 1 and 30 seconds", file=sys.stderr)
        return 2

    deadline = time.monotonic() + args.seconds
    with serial.Serial(args.port, args.baud, timeout=0.2) as handle:
        while time.monotonic() < deadline:
            data = handle.read(4096)
            if data:
                sys.stdout.buffer.write(data)
                sys.stdout.buffer.flush()

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
