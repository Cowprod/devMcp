#!/usr/bin/env php
<?php

declare(strict_types=1);

use Cowprod\DevMcp\Distributed\Admin\LocalProjectSnapshot;
use Cowprod\DevMcp\Distributed\Admin\PreviewHttpProbe;
use Cowprod\DevMcp\Mcp\RemoteTools;
use Cowprod\DevMcp\Project\ProjectRegistry;

require dirname(__DIR__) . '/vendor/autoload.php';

$configPath = getenv('DEVMCP_CONFIG') ?: '/etc/devmcp/global.php';
if (!is_file($configPath) || !is_readable($configPath)) {
    fwrite(STDERR, "Configuration locale indisponible\n");
    exit(1);
}
$config = require $configPath;
if (!is_array($config)) {
    fwrite(STDERR, "Configuration locale invalide\n");
    exit(1);
}
try {
    $remote = RemoteTools::fromConfig($config);
    $sql = $remote?->sqlProjectConfiguration();
    $registry = $sql !== null && $sql->isReady()
        ? ProjectRegistry::fromSql($sql)
        : ProjectRegistry::fromConfig($config);
    $snapshot = LocalProjectSnapshot::export($config, $registry);
    // The privileged exporter already has SQL access. Publish only validated,
    // non-secret local port metadata so the unprivileged Web admin requires
    // no new direct SELECT grant on the reservation table.
    if ($remote !== null) {
        try {
            $store = $remote->provisioningStore(['enabled' => true]);
            $byProject = [];
            foreach ($store->list() as $record) {
                if (($record['state'] ?? null) !== 'active'
                    || ($record['machine'] ?? null) !== $snapshot['host']['name']) {
                    continue;
                }
                $port = $record['preview_port'] ?? null;
                if (is_int($port) && $port >= 1024 && $port <= 65535) {
                    $byProject[$record['project_id']] = $port;
                }
            }
            foreach ($snapshot['projects'] as &$project) {
                if (isset($byProject[$project['id']])) {
                    $project['preview_port'] = $byProject[$project['id']];
                    $project['preview_http_local'] = PreviewHttpProbe::check($byProject[$project['id']])['state'];
                    $previewIp = $config['preview_zerotier_ipv4'] ?? '';
                    if ($previewIp === '' && $snapshot['host']['name'] === 'touchdeck') {
                        $previewIp = '192.168.194.189';
                    }
                    $project['preview_http_zerotier_host'] = is_string($previewIp)
                        && filter_var($previewIp, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) !== false
                        ? PreviewHttpProbe::check($byProject[$project['id']], $previewIp)['state'] : 'not_checked';
                    $project['preview_http_checked_at_utc'] = gmdate('Y-m-d\\TH:i:s\\Z');
                }
            }
            unset($project);
        } catch (\PDOException $error) {
            // Keep legacy project inventory available during staged migration.
            error_log('devmcp-admin snapshot preview ports unavailable: ' . get_class($error));
        }
    }
    $json = json_encode($snapshot, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR);
    $output = LocalProjectSnapshot::DEFAULT_PATH;
    $directory = dirname($output);
    if (!is_dir($directory) || !is_writable($directory)) {
        throw new RuntimeException('Répertoire de publication indisponible');
    }
    $temp = tempnam($directory, '.projects-');
    if ($temp === false) {
        throw new RuntimeException('Impossible de préparer le fichier temporaire');
    }
    try {
        if (file_put_contents($temp, $json . "\n", LOCK_EX) === false
            || !chmod($temp, 0640)
            || !rename($temp, $output)) {
            throw new RuntimeException('Publication atomique impossible');
        }
    } finally {
        if (is_file($temp)) {
            unlink($temp);
        }
    }
    echo 'OK: ', count($snapshot['projects']), " projet(s) locaux publiés\n";
} catch (Throwable $error) {
    fwrite(STDERR, 'Export impossible: ' . $error->getMessage() . "\n");
    exit(1);
}
