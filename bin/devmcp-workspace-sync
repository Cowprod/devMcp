#!/usr/bin/env php
<?php

declare(strict_types=1);

use Symfony\Component\Process\Process;

require dirname(__DIR__) . '/vendor/autoload.php';

$expectedRepository = $argv[1] ?? null;
$commit = $argv[2] ?? null;

if (
    !is_string($expectedRepository)
    || !preg_match('/^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/', $expectedRepository)
    || !is_string($commit)
    || !preg_match('/^[a-fA-F0-9]{40}$/', $commit)
) {
    fwrite(
        STDERR,
        "Usage: devmcp-workspace-sync <owner/repository> <40-char-sha>" . PHP_EOL,
    );
    exit(2);
}
$commit = strtolower($commit);

$root = getcwd();
if (!is_string($root) || !is_dir($root . '/.git')) {
    fwrite(STDERR, "Le cwd n'est pas un checkout Git." . PHP_EOL);
    exit(3);
}

$run = static function (array $command, int $timeout = 120) use ($root): string {
    $process = new Process($command, $root, null, null, $timeout);
    $process->run();

    if (!$process->isSuccessful()) {
        fwrite(STDERR, $process->getErrorOutput());
        fwrite(STDERR, $process->getOutput());
        exit($process->getExitCode() ?: 4);
    }

    return trim($process->getOutput());
};

$origin = $run(['/usr/bin/git', 'remote', 'get-url', 'origin'], 20);
$normalizedOrigin = null;

$patterns = [
    '~^https://github\.com/([^/]+/[^/]+?)(?:\.git)?$~i',
    '~^git@github\.com:([^/]+/[^/]+?)(?:\.git)?$~i',
    '~^ssh://git@github\.com/([^/]+/[^/]+?)(?:\.git)?$~i',
];

foreach ($patterns as $pattern) {
    if (preg_match($pattern, $origin, $matches) === 1) {
        $normalizedOrigin = strtolower($matches[1]);
        break;
    }
}

if ($normalizedOrigin !== strtolower($expectedRepository)) {
    fwrite(STDERR, "Le remote origin ne correspond pas au dépôt attendu." . PHP_EOL);
    exit(9);
}

$dirty = $run(['/usr/bin/git', 'status', '--porcelain', '--untracked-files=no'], 20);
if ($dirty !== '') {
    fwrite(STDERR, "Workspace refusé : fichiers suivis modifiés." . PHP_EOL);
    fwrite(STDERR, $dirty . PHP_EOL);
    exit(10);
}

$run(['/usr/bin/git', 'fetch', '--prune', '--no-tags', 'origin'], 300);
$run(['/usr/bin/git', 'cat-file', '-e', $commit . '^{commit}'], 20);

$remoteRefs = $run([
    '/usr/bin/git',
    'for-each-ref',
    '--format=%(refname)',
    '--contains=' . $commit,
    'refs/remotes/origin/',
], 20);

if ($remoteRefs === '') {
    fwrite(
        STDERR,
        "Le commit demandé n'est contenu dans aucune ref distante origin." . PHP_EOL,
    );
    exit(11);
}

$run(['/usr/bin/git', 'checkout', '--detach', $commit], 60);
$head = strtolower($run(['/usr/bin/git', 'rev-parse', 'HEAD'], 20));

if ($head !== $commit) {
    fwrite(STDERR, "HEAD ne correspond pas au commit demandé." . PHP_EOL);
    exit(12);
}

echo json_encode([
    'ok' => true,
    'repository' => $expectedRepository,
    'commit' => $head,
    'remote_refs' => preg_split('/\R/', $remoteRefs) ?: [],
], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . PHP_EOL;
