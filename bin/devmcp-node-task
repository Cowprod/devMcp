#!/usr/bin/env php
<?php
declare(strict_types=1);

use Symfony\Component\Process\Process;
require dirname(__DIR__) . '/vendor/autoload.php';

$operation = $argv[1] ?? '';
$node = $argv[2] ?? '';
$npm = $argv[3] ?? '';
$cwd = getcwd();
if (!is_string($cwd) || ($operation !== 'version' && !is_file($cwd . '/package.json'))) {
    fwrite(STDERR, "package.json required\n"); exit(2);
}
if (!in_array($operation, ['version', 'dependencies', 'test', 'build'], true)
    || !in_array($node, ['/usr/bin/node', '/usr/local/bin/node'], true)
    || !in_array($npm, ['/usr/bin/npm', '/usr/local/bin/npm'], true)) {
    fwrite(STDERR, "Unapproved Node task or executable\n"); exit(2);
}
$package = $operation === 'version' ? [] : json_decode(file_get_contents($cwd . '/package.json') ?: '', true);
if (!is_array($package)) { fwrite(STDERR, "Invalid package.json\n"); exit(2); }
if ($operation === 'version') { $cmd = [$node, '--version']; }
elseif ($operation === 'dependencies') { $cmd = [$npm, is_file($cwd . '/package-lock.json') ? 'ci' : 'install', '--no-audit', '--no-fund']; }
else {
    if (!isset($package['scripts'][$operation]) || !is_string($package['scripts'][$operation])) {
        fwrite(STDERR, "Script not declared in package.json\n"); exit(3);
    }
    $cmd = [$npm, 'run', $operation];
}
$timeout = $operation === 'dependencies' ? 900 : ($operation === 'test' ? 600 : 900);
$process = new Process($cmd, $cwd, ['CI' => 'true'], null, $timeout);
$process->run(static function ($type, $buffer): void {
    // Existing devMcp job runner enforces persistent output limits.
    echo $buffer;
});
exit($process->getExitCode() ?? 1);
