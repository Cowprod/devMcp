#!/usr/bin/env php
<?php

declare(strict_types=1);

use Cowprod\DevMcp\Distributed\Registry\DatabaseConnection;
use Cowprod\DevMcp\Project\ProjectRuntimeCatalog;
use Cowprod\DevMcp\Project\ProjectServiceLaunchPlan;
use Cowprod\DevMcp\Project\ProjectServicePortGuard;
use Cowprod\DevMcp\Project\ProjectServiceRequestPolicy;
use Symfony\Component\Process\Process;

require dirname(__DIR__) . '/vendor/autoload.php';

/**
 * Root-owned fixed systemd timer. Input is an untrusted bounded spool produced
 * by a NoNewPrivileges MCP worker; never execute a command from spool/SQL.
 */
if (count($argv) !== 1 || !function_exists('posix_geteuid') || posix_geteuid() !== 0) {
    fwrite(STDERR, "Only the privileged service timer may reconcile requests\n");
    exit(2);
}

$requests = '/var/lib/devmcp/project-service-requests';
$results = '/run/devmcp-project-results';
if (!is_dir($requests) || !is_dir($results)
    || is_link($requests) || is_link($results)) {
    fwrite(STDERR, "Project service queues not installed\n");
    exit(1);
}
$lock = fopen('/run/lock/devmcp-project-service.lock', 'c');
if ($lock === false || !flock($lock, LOCK_EX | LOCK_NB)) {
    exit(0); // Another fixed controller is already running.
}

function controllerSql(): array
{
    $configPath = '/etc/devmcp/global.php';
    if (!is_file($configPath) || !is_readable($configPath)
        || !is_array($config = require $configPath)) {
        throw new RuntimeException('Global configuration unavailable');
    }
    $path = $config['distributed']['config_path'] ?? '/etc/devmcp/mcp-distributed.php';
    if (!is_string($path) || !is_file($path) || !is_readable($path)
        || !is_array($sql = require $path)) {
        throw new RuntimeException('SQL configuration unavailable');
    }
    $db = DatabaseConnection::connect(
        (string) $sql['dsn'], (string) $sql['writer_username'], (string) $sql['writer_password']
    );
    return [$config, $db];
}

function controllerRun(array $argv, int $timeout = 40): array
{
    $process = new Process($argv, '/', ['PATH' => '/usr/bin:/bin'], null, $timeout);
    $process->run();
    return [
        'ok' => $process->isSuccessful(),
        'stdout' => substr($process->getOutput(), 0, 8000),
        'stderr' => substr($process->getErrorOutput(), 0, 512),
    ];
}

function controllerServiceStatus(string $unit): array
{
    $run = controllerRun([
        '/usr/bin/systemctl', 'show', $unit, '--no-pager',
        '--property=LoadState,ActiveState,SubState,MainPID,NRestarts',
    ], 10);
    $fields = [];
    if ($run['ok']) {
        foreach (explode("\n", trim($run['stdout'])) as $line) {
            $parts = explode('=', $line, 2);
            if (count($parts) === 2 && in_array($parts[0],
                ['LoadState', 'ActiveState', 'SubState', 'MainPID', 'NRestarts'], true)) {
                $fields[$parts[0]] = $parts[1];
            }
        }
    }
    return $fields + ['LoadState' => 'unknown', 'ActiveState' => 'unknown'];
}

function controllerHealth(string $ip, int $port, string $path): array
{
    if (filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) === false
        || $port < 1024 || $port > 65535
        || preg_match('~^/[A-Za-z0-9_./-]{0,100}$~D', $path) !== 1
        || str_contains($path, '..')) {
        return ['http_checked' => false, 'http_status' => null];
    }
    $errno = 0;
    $message = '';
    $socket = @stream_socket_client('tcp://' . $ip . ':' . $port,
        $errno, $message, 2, STREAM_CLIENT_CONNECT);
    if ($socket === false) {
        return ['http_checked' => true, 'http_status' => null];
    }
    stream_set_timeout($socket, 2);
    fwrite($socket, "GET " . $path . " HTTP/1.0\r\nHost: " . $ip . "\r\nConnection: close\r\n\r\n");
    $line = fgets($socket, 256);
    fclose($socket);
    $status = is_string($line) && preg_match('~^HTTP/1\.[01] ([0-9]{3}) ~', $line, $m) === 1
        ? (int) $m[1] : null;
    return ['http_checked' => true, 'http_status' => $status];
}

function controllerProcess(PDO $db, array $config, string $id, string $operation): array
{
    ProjectServiceRequestPolicy::validate($operation, $id);
    $hostname = gethostname();
    if (!is_string($hostname) || $hostname === '') {
        throw new RuntimeException('Unknown host');
    }
    $query = $db->prepare(
        'SELECT p.project_id, p.state, p.machine, p.workspace_path, p.actions_enabled, '
        . 'r.port, x.runtime_type, x.entrypoint, x.document_root, x.health_path, '
        . 'x.desired_state, x.revision, t.supervisor, t.protocol, t.selectable '
        . 'FROM dm_project_provisioning p '
        . 'INNER JOIN dm_preview_port_reservation r '
        . 'ON r.project_id = p.project_id AND r.machine = p.machine '
        . 'LEFT JOIN dm_project_runtime x ON x.project_id = p.project_id '
        . 'LEFT JOIN dm_runtime_type t ON t.code = x.runtime_type '
        . 'WHERE p.project_id = ? LIMIT 1'
    );
    $query->execute([$id]);
    $row = $query->fetch(PDO::FETCH_ASSOC);
    if (!is_array($row) || $row['machine'] !== $hostname || $row['state'] !== 'active'
        || (int) $row['actions_enabled'] !== 1) {
        throw new RuntimeException('Project not active and authorized on this host');
    }
    $root = $config['project_provisioning']['local_workspace_root']
        ?? '/srv/devmcp/workspaces';
    if (!is_string($root) || $row['workspace_path'] !== realpath($root . '/' . $id)
        || ProjectServiceRequestPolicy::projectFromCwd(
            (string) $row['workspace_path'], $root
        ) !== $id) {
        throw new RuntimeException('Project workspace no longer authorized');
    }
    $port = (int) $row['port'];
    if ($port < 1024 || $port > 65535) {
        throw new RuntimeException('Invalid reserved port');
    }
    $ip = $config['preview_zerotier_ipv4']
        ?? ($hostname === 'touchdeck' ? '192.168.194.189' : null);
    $unit = ProjectServiceRequestPolicy::unit($id);

    if ($operation === 'select-node') {
        if (!is_string($ip) || filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) === false) {
            throw new RuntimeException('ZeroTier address not configured');
        }
        $trial = $row;
        $trial['runtime_type'] = 'node';
        $trial['entrypoint'] = 'server.js';
        $trial['desired_state'] = 'running';
        $trial['port'] = $port;
        ProjectServiceLaunchPlan::build($trial, $root, $ip);
        $revision = isset($row['revision']) ? (int) $row['revision'] : 0;
        $selected = (new ProjectRuntimeCatalog($db))->select($id, 'node', $revision);
        return ['ok' => true, 'selected_runtime' => $selected['runtime_type'],
            'desired_state' => 'stopped', 'port' => $port, 'service_started' => false];
    }
    if ($operation === 'start' || $operation === 'restart') {
        if (!is_string($ip) || filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) === false) {
            throw new RuntimeException('ZeroTier address not configured');
        }
        $probe = @stream_socket_server('tcp://' . $ip . ':0', $errno, $message,
            STREAM_SERVER_BIND | STREAM_SERVER_LISTEN);
        if ($probe === false) {
            throw new RuntimeException('ZeroTier IP not assigned locally');
        }
        fclose($probe);
        if (!in_array($row['runtime_type'], ['node', 'php', 'static'], true)
            || $row['supervisor'] !== 'systemd' || $row['protocol'] !== 'http'
            || (int) $row['selectable'] !== 1) {
            throw new RuntimeException('Runtime is not explicitly authorized');
        }
        $trial = $row;
        $trial['desired_state'] = 'running';
        $trial['port'] = $port;
        ProjectServiceLaunchPlan::build($trial, $root, $ip);
        if ($operation === 'restart' && $row['desired_state'] !== 'running') {
            throw new RuntimeException('Cannot restart a stopped service');
        }
        // A port collision must be rejected before changing SQL desired_state.
        // For an already active unit, only a matching running state is valid.
        $currentService = controllerServiceStatus($unit);
        ProjectServicePortGuard::assertStartAllowed(
            $ip, $port, (string) $row['desired_state'],
            (string) $currentService['ActiveState']
        );
        if ($operation === 'start' && $row['desired_state'] === 'stopped') {
            $change = $db->prepare("UPDATE dm_project_runtime SET desired_state = 'running', "
                . 'revision = revision + 1 WHERE project_id = ? '
                . "AND desired_state = 'stopped' AND revision = ?");
            $change->execute([$id, $row['revision']]);
            if ($change->rowCount() !== 1) {
                throw new RuntimeException('Concurrent runtime state update');
            }
        }
        $command = $operation === 'start'
            ? ['/usr/bin/systemctl', 'enable', '--now', $unit]
            : ['/usr/bin/systemctl', 'restart', $unit];
        $run = controllerRun($command, 40);
        $service = controllerServiceStatus($unit);
        $healthPath = is_string($row['health_path']) ? $row['health_path'] : '/';
        $health = ['http_checked' => false, 'http_status' => null];
        // Type=simple startup can precede listener initialization.
        for ($i = 0; $i < 8 && $service['ActiveState'] === 'active'; $i++) {
            $health = controllerHealth($ip, $port, $healthPath);
            if ($health['http_status'] === 200) {
                break;
            }
            usleep(250000);
        }
        $healthy = $run['ok'] && $service['ActiveState'] === 'active'
            && $health['http_status'] === 200;
        return array_merge([
            'ok' => $healthy, 'desired_state' => 'running', 'service' => $service,
            'url' => 'http://' . $ip . ':' . $port,
            'note' => $healthy ? 'HTTP local valide; pair ZeroTier distant non encore teste'
                : 'Processus/HTTP non confirmes; verifier status et logs',
        ], $health);
    }
    if ($operation === 'stop') {
        if ($row['desired_state'] === 'running') {
            $change = $db->prepare("UPDATE dm_project_runtime SET desired_state = 'stopped', "
                . 'revision = revision + 1 WHERE project_id = ? '
                . "AND desired_state = 'running' AND revision = ?");
            $change->execute([$id, $row['revision']]);
            if ($change->rowCount() !== 1) {
                throw new RuntimeException('Concurrent runtime state update');
            }
        }
        $run = controllerRun(['/usr/bin/systemctl', 'disable', '--now', $unit], 40);
        $service = controllerServiceStatus($unit);
        return ['ok' => $run['ok'] && $service['ActiveState'] !== 'active',
            'desired_state' => 'stopped', 'service' => $service];
    }
    if ($operation === 'logs') {
        $run = controllerRun(['/usr/bin/journalctl', '-u', $unit, '--no-pager',
            '--output=cat', '--lines=40'], 10);
        $logs = $run['stdout'];
        $logs = preg_replace(
            '/(?i)(authorization|token|password|secret|api[_-]?key)\s*[:=]\s*\S+/',
            '$1=[REDACTED]', $logs
        ) ?? '';
        return ['ok' => $run['ok'], 'logs' => substr($logs, -6000)];
    }
    $service = controllerServiceStatus($unit);
    $healthPath = is_string($row['health_path']) ? $row['health_path'] : '/';
    $health = is_string($ip) && $service['ActiveState'] === 'active'
        ? controllerHealth($ip, $port, $healthPath)
        : ['http_checked' => false, 'http_status' => null];
    return array_merge(['ok' => true, 'desired_state' => $row['desired_state'] ?? 'not_configured',
        'runtime_type' => $row['runtime_type'], 'service' => $service,
        'port' => $port, 'url' => is_string($ip) ? 'http://' . $ip . ':' . $port : null,
        'note' => 'HTTP sondé seulement depuis la machine locale; pair distant non testé'], $health);
}

// Results are root-owned and readable by devmcp, never writable by it.
// Prune old results without trusting worker-controlled file names.
foreach (glob($results . '/*.json') ?: [] as $oldResult) {
    if (!is_link($oldResult) && is_file($oldResult)
        && (filemtime($oldResult) ?: 0) < time() - 600) {
        @unlink($oldResult);
    }
}
$files = glob($requests . '/*.json') ?: [];
usort($files, static fn(string $a, string $b): int =>
    (filemtime($a) ?: 0) <=> (filemtime($b) ?: 0));
if ($files === []) {
    exit(0);
}
try {
    [$config, $db] = controllerSql();
} catch (Throwable $error) {
    fwrite(STDERR, "Project service SQL unavailable: " . get_class($error) . "\n");
    exit(1); // Preserve requests for retry.
}
foreach (array_slice($files, 0, 3) as $file) {
    if (is_link($file) || !is_file($file)
        || filesize($file) === false || filesize($file) > 1024) {
        continue;
    }
    if (!preg_match('/^([a-z0-9][a-z0-9._-]{0,63})\.([a-f0-9]{24})\.json$/D',
        basename($file), $matched)) {
        continue;
    }
    $data = file_get_contents($file);
    $request = is_string($data) ? json_decode($data, true) : null;
    $id = $matched[1];
    $token = $matched[2];
    $issued = is_array($request) ? strtotime((string) ($request['issued_at_utc'] ?? '')) : false;
    if ($issued === false || abs(time() - $issued) > 90) {
        @unlink($file);
        continue; // Stale requests never execute after a delayed restart.
    }
    if (!is_array($request) || ($request['project_id'] ?? null) !== $id
        || ($request['request_id'] ?? null) !== $token) {
        @unlink($file);
        continue;
    }
    try {
        $op = $request['operation'] ?? null;
        if (!is_string($op)) {
            throw new RuntimeException('Invalid operation');
        }
        $result = controllerProcess($db, $config, $id, $op);
    } catch (Throwable $error) {
        $result = ['ok' => false, 'error_class' => get_class($error),
            'error' => 'Project service request rejected'];
    }
    $result['project_id'] = $id;
    $result['request_id'] = $token;
    $result['processed_at_utc'] = gmdate('c');
    $encoded = json_encode($result, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    $target = $results . '/' . $token . '.json';
    $temp = $target . '.tmp';
    if (is_string($encoded) && strlen($encoded) <= 16000
        && file_put_contents($temp, $encoded, LOCK_EX) === strlen($encoded)) {
        chmod($temp, 0640);
        if (rename($temp, $target)) {
            @unlink($file);
        }
    }
}
