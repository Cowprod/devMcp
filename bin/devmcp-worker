#!/usr/bin/env php
<?php

declare(strict_types=1);

use Cowprod\DevMcp\Audit\AuditLogger;
use Cowprod\DevMcp\Execution\FileJobStore;
use Cowprod\DevMcp\Execution\JobWorker;
use Cowprod\DevMcp\Project\ProjectRegistry;

require dirname(__DIR__) . '/vendor/autoload.php';

$configPath = getenv('DEVMCP_CONFIG') ?: dirname(__DIR__) . '/config/global.php';

if (!is_file($configPath)) {
    fwrite(STDERR, "Configuration devMcp introuvable : {$configPath}" . PHP_EOL);
    exit(2);
}

$config = require $configPath;
if (!is_array($config)) {
    fwrite(STDERR, "La configuration devMcp doit retourner un tableau PHP." . PHP_EOL);
    exit(2);
}

$projects = ProjectRegistry::fromConfig($config);
$auditFile = $config['audit']['file'] ?? dirname(__DIR__) . '/var/audit.jsonl';
$jobsDirectory = $config['jobs']['directory'] ?? dirname(__DIR__) . '/var/jobs';
$maxJobLog = $config['limits']['max_job_log_bytes'] ?? 4194304;

if (!is_string($auditFile) || !is_string($jobsDirectory) || !is_int($maxJobLog)) {
    throw new RuntimeException('Configuration worker invalide');
}

$audit = new AuditLogger($auditFile);
$store = new FileJobStore($jobsDirectory, $maxJobLog);
$worker = new JobWorker($projects, $store, $audit);

if (in_array('--once', $argv, true)) {
    exit($worker->runOnce() ? 0 : 3);
}

$worker->runForever();
