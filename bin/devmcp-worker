#!/usr/bin/env php
<?php

declare(strict_types=1);

use Cowprod\DevMcp\Execution\JobWorker;
use Cowprod\DevMcp\Runtime\RuntimeFactory;

require dirname(__DIR__) . '/vendor/autoload.php';

$configPath = getenv('DEVMCP_CONFIG') ?: dirname(__DIR__) . '/config/global.php';
$target = getenv('DEVMCP_TARGET') ?: 'local';

if (!preg_match('/^[a-z0-9][a-z0-9._-]{0,63}$/', $target)) {
    fwrite(STDERR, "DEVMCP_TARGET invalide." . PHP_EOL);
    exit(2);
}

if (!is_file($configPath)) {
    fwrite(STDERR, "Configuration devMcp introuvable : {$configPath}" . PHP_EOL);
    exit(2);
}

$config = require $configPath;
if (!is_array($config)) {
    fwrite(STDERR, "La configuration devMcp doit retourner un tableau PHP." . PHP_EOL);
    exit(2);
}

$runtime = RuntimeFactory::fromConfig($config, dirname(__DIR__) . '/var');
$worker = new JobWorker(
    $runtime->projects,
    $runtime->jobsStore,
    $runtime->audit,
    $target,
);

if (in_array('--once', $argv, true)) {
    exit($worker->runOnce() ? 0 : 3);
}

// A long-lived worker keeps a PDO connection inside ProjectRegistry. MariaDB
// may close that idle connection while the file-backed job queue remains live
// (SQLSTATE[HY000] 2006). Refresh the runtime when idle, and after every
// completed job. Never recycle during a running job. The SQL registry remains
// authoritative and no failed action is replayed implicitly.
$runtimeBornAt = hrtime(true);
$nextDeploymentPreparation=0;
while (true) {
    $processed = $worker->runOnce();
    if(!$processed&&hrtime(true)>=$nextDeploymentPreparation){$processed=$runtime->tools->prepareDeploymentJobs();$nextDeploymentPreparation=hrtime(true)+2_000_000_000;}
    if ($processed || hrtime(true) - $runtimeBornAt >= 60_000_000_000) {
        $runtime = RuntimeFactory::fromConfig($config, dirname(__DIR__) . '/var');
        $worker = new JobWorker(
            $runtime->projects,
            $runtime->jobsStore,
            $runtime->audit,
            $target,
        );
        $runtimeBornAt = hrtime(true);
    }
    if (!$processed) {
        usleep(250000);
    }
}

