#!/usr/bin/env php
<?php
declare(strict_types=1);

// Fixed-purpose TouchDeck OTA client. Never prints the PM2 environment or token.
const BASE = 'http://127.0.0.1:3000';
const ROOT = '/srv/devmcp-workspaces/touchDeck';
const FIRMWARE = ROOT . '/.pio/build/esp32c3_diagnostic/firmware.bin';
const PM2 = '/usr/bin/pm2';

function fail(string $message): never { fwrite(STDERR, $message . "\n"); exit(1); }
function command(array $argv, array $env = []): array {
    $pipes = [];
    $process = proc_open($argv, [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, ROOT, array_merge(getenv() ?: [], $env));
    if (!is_resource($process)) fail('Local process unavailable');
    fclose($pipes[0]);
    $stdout = stream_get_contents($pipes[1], 1024 * 1024);
    $stderr = stream_get_contents($pipes[2], 1024 * 1024);
    fclose($pipes[1]); fclose($pipes[2]);
    return [proc_close($process), $stdout, $stderr];
}
function api(string $path, ?array $body = null, ?string $token = null): array {
    $headers = ['Accept: application/json'];
    if ($body !== null) $headers[] = 'Content-Type: application/json';
    if ($token !== null) $headers[] = 'Authorization: Bearer ' . $token;
    $context = stream_context_create(['http' => [
        'method' => $body === null ? 'GET' : 'POST',
        'header' => implode("\r\n", $headers),
        'content' => $body === null ? '' : json_encode($body, JSON_THROW_ON_ERROR),
        'timeout' => 12,
        'ignore_errors' => true,
        'follow_location' => 0,
    ]]);
    $raw = @file_get_contents(BASE . $path, false, $context);
    $statusLine = $http_response_header[0] ?? '';
    $status = preg_match('~^HTTP/\\S+ ([0-9]{3})~', $statusLine, $match) ? (int)$match[1] : 0;
    if (!is_string($raw) || strlen($raw) > 262144) fail('TouchDeck API unavailable');
    $data = json_decode($raw, true);
    if (!is_array($data)) fail('Invalid TouchDeck API response');
    return [$status, $data];
}
function secret(): string {
    [$code, $output] = command([PM2, 'jlist'], ['PM2_HOME' => '/var/lib/devmcp/pm2']);
    if ($code !== 0) fail('PM2 metadata unavailable');
    $apps = json_decode($output, true);
    if (!is_array($apps)) fail('Invalid PM2 metadata');
    foreach ($apps as $app) {
        if (($app['name'] ?? null) !== 'touchdeck-server') continue;
        $token = $app['pm2_env']['TOUCHDECK_OTA_ADMIN_TOKEN'] ?? null;
        if (is_string($token) && strlen($token) >= 16) return $token;
    }
    fail('OTA token unavailable in PM2 environment');
}
function projectVersion(): string {
    $ini = ROOT . '/platformio.ini';
    if (!is_file($ini) || is_link($ini) || realpath($ini) !== $ini) fail('version: platformio.ini missing or unsafe');
    $content = file_get_contents($ini);
    if (!is_string($content)) fail('version: cannot read platformio.ini');
    if (!preg_match('/^\\[env:esp32c3_diagnostic\\]\\s*$/m', $content, $section, PREG_OFFSET_CAPTURE)) fail('version: target environment absent');
    $tail = substr($content, $section[0][1] + strlen($section[0][0]));
    $next = preg_match('/^\\[/m', $tail, $match, PREG_OFFSET_CAPTURE) ? $match[0][1] : strlen($tail);
    $target = substr($tail, 0, $next);
    preg_match_all('/^\\s*-D\\s+TOUCHDECK_VERSION\\s*=\\s*\\\\?"(\\d+\\.\\d+\\.\\d+)\\\\?"\\s*$/m', $target, $matches);
    if (count($matches[1]) !== 1) fail('version: missing, ambiguous or invalid TOUCHDECK_VERSION');
    return $matches[1][0];
}
function verifiedBuild(string $version): array {
    if (!is_file(FIRMWARE) || is_link(FIRMWARE) || realpath(FIRMWARE) !== FIRMWARE) fail('binary: missing or unsafe firmware');
    $size = filesize(FIRMWARE);
    if (!is_int($size) || $size < 4096 || $size > 1310720) fail('binary: invalid firmware size');
    $bytes = file_get_contents(FIRMWARE);
    if (!is_string($bytes) || strlen($bytes) !== $size || $bytes[0] !== "\\xE9") fail('binary: invalid ESP32-C3 image');
    if (!str_contains($bytes, $version)) fail('binary: compiled firmware does not contain project version');
    return [$size, hash('sha256', $bytes)];
}
function clients(): array {
    [$status, $body] = api('/api/admin/clients');
    if ($status !== 200 || !isset($body['clients']) || !is_array($body['clients'])) fail('Client inventory unavailable');
    return array_values(array_filter($body['clients'], static fn($c) => is_array($c) && ($c['deviceType'] ?? null) === 'esp32c3'));
}
function manifest(): array {
    [$status, $body] = api('/api/firmware/manifest');
    if ($status !== 200) fail('Firmware manifest unavailable');
    return $body;
}
function output(array $value): void {
    echo json_encode($value, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT) . "\n";
}
$operation = $argv[1] ?? '';
if ($operation === 'status') {
    output(['manifest' => manifest(), 'devices' => clients()]);
    exit(0);
}
if ($operation === 'publish') {
    $version = projectVersion();
    // Do not allow concurrent publish jobs to race over the same build artifact.
    $lock = fopen('/tmp/devmcp-touchdeck-ota-publish.lock', 'c');
    if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) fail('build: another OTA publication is in progress');
    [$exit] = command(['/opt/devmcp-tools/platformio/bin/pio', 'run', '-e', 'esp32c3_diagnostic']);
    if ($exit !== 0) fail('build: PlatformIO compilation failed');
    if (projectVersion() !== $version) fail('version: project version changed during build');
    [$size, $hash] = verifiedBuild($version);
    [$status, $published] = api('/api/admin/firmware/publish', ['version' => $version, 'sha256' => $hash, 'size' => $size], secret());
    if ($status !== 200 || ($published['ok'] ?? false) !== true ||
        ($published['version'] ?? null) !== $version ||
        ($published['size'] ?? null) !== $size ||
        ($published['sha256'] ?? null) !== $hash) {
        fail('publish: API rejected or returned mismatched release (HTTP ' . $status . ', reason ' . ($published['error'] ?? 'verification_failed') . ')');
    }
    $m = manifest();
    if (($m['available'] ?? false) !== true || ($m['version'] ?? null) !== $version ||
        ($m['sha256'] ?? null) !== $hash || ($m['size'] ?? null) !== $size) fail('manifest: release metadata mismatch');
    output(['published' => true, 'version' => $version, 'size' => $size, 'sha256' => $hash]);
    exit(0);
}
if ($operation === 'update') {
    $id = $argv[2] ?? '';
    if (!preg_match('/^[A-Za-z0-9._:-]{1,100}$/D', $id)) fail('Invalid device identifier');
    $known = null;
    foreach (clients() as $client) {
        if (($client['id'] ?? null) === $id && ($client['online'] ?? false) === true) $known = $client;
    }
    if ($known === null) fail('ESP32-C3 not connected or unknown');
    $m = manifest();
    if (($m['available'] ?? false) !== true || !is_string($m['version'] ?? null) || !preg_match('/^\\d+\\.\\d+\\.\\d+$/D', $m['version'])) fail('Expected firmware not published');
    $version = $m['version'];
    [$status, $result] = api('/api/admin/firmware/update', ['clientId' => $id], secret());
    if ($status !== 202 || ($result['ok'] ?? false) !== true || ($result['clientId'] ?? null) !== $id) fail('OTA request rejected');
    // A 202 only confirms delivery of the command. Verify the reported firmware after reconnect.
    $deadline = time() + 150;
    $seenOffline = false;
    while (time() < $deadline) {
        sleep(3);
        try { $devices = clients(); } catch (Throwable $ignored) { continue; }
        $current = null;
        foreach ($devices as $device) {
            if (($device['id'] ?? null) === $id) { $current = $device; break; }
        }
        if ($current === null || ($current['online'] ?? false) !== true) {
            $seenOffline = true;
            continue;
        }
        $installed = $current['firmwareVersion'] ?? '';
        if (is_string($installed) && preg_match('/^' . preg_quote($version, '/') . '(?:\\+|$)/D', $installed)) {
            output(['accepted' => true, 'installed' => true, 'device' => $id,
                'installed_version' => $installed, 'reconnected' => $seenOffline,
                'message' => 'Firmware version verified on an online ESP32-C3']);
            exit(0);
        }
    }
    output(['accepted' => true, 'installed' => false, 'device' => $id, 'target_version' => $version,
        'message' => 'Timed out waiting for online ESP32-C3 reporting target firmware']);
    exit(1);
}
fail('Unsupported operation');
