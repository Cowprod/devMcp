#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Socket-activated ROOT worker, installed only by explicit central opt-in.
 * Never execute shell, arbitrary SQL, caller paths, alternate machines or
 * per-runtime grants. Reuse the root-only three-demo SQL transaction.
 */
use Cowprod\DevMcp\Distributed\Admin\HostingLabBatchConsent;
use Cowprod\DevMcp\Distributed\Admin\HostingLabBatchEnqueue;
use Cowprod\DevMcp\Distributed\Admin\HostingLabCentralInspection;
use Cowprod\DevMcp\Distributed\Admin\HostingLabMachineResolver;
use Cowprod\DevMcp\Distributed\Admin\HostingLabOperatorRequest;
use Cowprod\DevMcp\Distributed\Admin\HostingLabSchemaMigration;
use Cowprod\DevMcp\Distributed\Registry\DatabaseConnection;

function hostingOperatorTrustedPath(string $path, bool $directory = false): void
{
    clearstatcache(true, $path);
    $meta = @lstat($path);
    if (!is_array($meta) || $meta['uid'] !== 0
        || ($meta['mode'] & 0170000) !== ($directory ? 0040000 : 0100000)
        || ($meta['mode'] & 0022) !== 0
        || (!$directory && ($meta['nlink'] !== 1 || $meta['size'] < 1 || $meta['size'] > 65536))) {
        throw new RuntimeException('Untrusted central operator code or configuration');
    }
}

function hostingOperatorMain(): int
{
    if (!function_exists('posix_geteuid') || posix_geteuid() !== 0) {
        throw new RuntimeException('Central operator requires root');
    }
    // This is independent from /etc/devmcp/global.php (MCP-controlled).
    // Do not load Composer/vendor or any PHP from a group-writable checkout.
    foreach (['/opt', '/opt/devmcp', '/opt/devmcp/bin', '/opt/devmcp/src',
        '/opt/devmcp/src/Distributed', '/opt/devmcp/src/Distributed/Admin',
        '/opt/devmcp/src/Distributed/Registry', '/etc', '/etc/devmcp-admin'] as $dir) {
        hostingOperatorTrustedPath($dir, true);
    }
    hostingOperatorTrustedPath(__FILE__);
    $files = [
        dirname(__DIR__) . '/src/Distributed/Admin/HostingLabBatchConsent.php',
        dirname(__DIR__) . '/src/Distributed/Admin/HostingLabOperatorRequest.php',
        dirname(__DIR__) . '/src/Distributed/Admin/HostingLabSchemaMigration.php',
        dirname(__DIR__) . '/src/Distributed/Admin/HostingLabMachineResolver.php',
        dirname(__DIR__) . '/src/Distributed/Admin/HostingLabBatchEnqueue.php',
        dirname(__DIR__) . '/src/Distributed/Admin/HostingLabCentralInspection.php',
        dirname(__DIR__) . '/src/Distributed/Registry/DatabaseConnection.php',
    ];
    foreach ($files as $path) {
        hostingOperatorTrustedPath($path);
        require_once $path;
    }
    $configPath = '/etc/devmcp-admin/distributed.php';
    hostingOperatorTrustedPath($configPath);
    $config = require $configPath;
    if (!is_array($config)
        || ($config['remote_hosting_queue_enabled'] ?? null) !== true
        || ($config['hosting_lab_operator_socket_enabled'] ?? null) !== true
        || !is_string($config['hosting_lab_operator_machine_name'] ?? null)
        || $config['hosting_lab_operator_machine_name'] !== 'caseRouter') {
        throw new RuntimeException('Central root operator not explicitly opted in');
    }
    $raw = stream_get_contents(STDIN, 513);
    if (!is_string($raw) || strlen($raw) > 512) {
        throw new InvalidArgumentException('Invalid central operator input length');
    }
    $request = HostingLabOperatorRequest::parse(
        $raw, $config['hosting_lab_operator_machine_name']
    );

    $db = DatabaseConnection::connect(
        (string) ($config['dsn'] ?? ''),
        (string) ($config['writer_username'] ?? ''),
        (string) ($config['writer_password'] ?? '')
    );
    $machineId = HostingLabMachineResolver::resolve($db, $request['machine_name']);
    $result = $request['phase'] === 'inspect'
        ? ['phase' => 'inspect'] + HostingLabCentralInspection::inspect(
            $db, $request['machine_name'], true
        )
        : HostingLabBatchEnqueue::enqueue(
            $db, $machineId, $request['revision'], $request['phase']
        );
    echo json_encode([
        'version' => 1, 'ok' => true, 'result' => $result,
    ], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES) . "\n";
    return 0;
}

try {
    exit(hostingOperatorMain());
} catch (Throwable $error) {
    // No credentials, query text, request input or local paths on the wire.
    echo "{\"version\":1,\"ok\":false,\"error\":\"central_operator_rejected\"}\n";
    exit(1);
}
