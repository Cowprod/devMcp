#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Explicit central root-only handoff of ONE fresh independently signed peer
 * observation. The caseRouter root executor, not this central, verifies HMAC.
 *
 * stdin: {"approval":"COMMIT_CASE_HOSTING_LAB","proof":{...}}
 * No HTTP/MCP or agent-readonly action exposes this command.
 */
require dirname(__DIR__) . '/vendor/autoload.php';

use Cowprod\DevMcp\Distributed\Admin\HostingLabCommitEnqueue;
use Cowprod\DevMcp\Distributed\Registry\DatabaseConnection;

try {
    if (!function_exists('posix_geteuid') || posix_geteuid() !== 0
        || $argc !== 1) {
        throw new RuntimeException('Central root hosting commit command required');
    }
    $raw = stream_get_contents(STDIN, 4097);
    if (!is_string($raw) || $raw === '' || strlen($raw) > 4096) {
        throw new InvalidArgumentException('Invalid peer claim payload size');
    }
    $consent = json_decode($raw, true, 8, JSON_THROW_ON_ERROR);
    if (!is_array($consent) || array_is_list($consent)) {
        throw new InvalidArgumentException('Invalid hosting commit consent');
    }
    $keys = array_keys($consent);
    sort($keys);
    if ($keys !== ['approval', 'proof']
        || ($consent['approval'] ?? null) !== 'COMMIT_CASE_HOSTING_LAB'
        || !is_array($consent['proof'])
        || array_is_list($consent['proof'])) {
        throw new InvalidArgumentException('Explicit root hosting commit approval missing');
    }

    $configPath = '/etc/devmcp-admin/distributed.php';
    foreach (['/etc', '/etc/devmcp-admin'] as $directory) {
        clearstatcache(true, $directory);
        $meta = @lstat($directory);
        if (!is_array($meta) || ($meta['mode'] & 0170000) !== 0040000
            || $meta['uid'] !== 0 || ($meta['mode'] & 0022) !== 0) {
            throw new RuntimeException('Untrusted central hosting configuration directory');
        }
    }
    clearstatcache(true, $configPath);
    $meta = @lstat($configPath);
    if (!is_array($meta) || ($meta['mode'] & 0170000) !== 0100000
        || $meta['uid'] !== 0 || ($meta['mode'] & 0022) !== 0
        || $meta['nlink'] !== 1 || $meta['size'] < 1 || $meta['size'] > 65536) {
        throw new RuntimeException('Untrusted central hosting configuration');
    }
    $config = require $configPath;
    if (!is_array($config)
        || ($config['remote_hosting_queue_enabled'] ?? false) !== true) {
        throw new RuntimeException('Central hosting queue is not opted in');
    }

    $db = DatabaseConnection::connect(
        (string) ($config['dsn'] ?? ''),
        (string) ($config['writer_username'] ?? ''),
        (string) ($config['writer_password'] ?? '')
    );
    $result = HostingLabCommitEnqueue::enqueue($db, $consent['proof']);
    echo json_encode($result, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES) . "\n";
    exit(0);
} catch (Throwable $error) {
    // Never echo the supplied signed proof, host configuration or secrets.
    fwrite(STDERR, 'Central signed hosting commit rejected: ' . get_class($error) . "\n");
    exit(1);
}
