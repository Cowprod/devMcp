{
  "name": "cowprod/dev-mcp",
  "description": "MCP PHP générique pour l'exécution contrôlée des opérations de développement Cowprod",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "mcp/sdk": "dev-server-stdio-dual-era#2456cc3b60e8bf48d4b2ff6b4c4c5b878dbbe1a9",
    "symfony/process": "^7.3",
    "nyholm/psr7": "^1.8",
    "laminas/laminas-httphandlerrunner": "^2.13"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Cowprod\\DevMcp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cowprod\\DevMcp\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
