[Unit]
Description=Dedicated devMcp PM2 process manager
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=devmcp
Group=devmcp
Environment=PM2_HOME=/var/lib/devmcp/pm2
Environment=HOME=/var/lib/devmcp
ExecStart=/usr/bin/pm2 resurrect
ExecStop=/usr/bin/pm2 kill
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
