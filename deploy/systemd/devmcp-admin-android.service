[Unit]
Description=Inventaire ADB, captures d'écran et diagnostics MultiCam pour devMcp Admin
After=local-fs.target

[Service]
Type=oneshot
User=devmcp
Group=devmcp
Environment=HOME=/var/lib/devmcp
UMask=0027
ExecStart=/usr/bin/php /opt/devmcp/bin/devmcp-admin-android
TimeoutStartSec=240
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=no
