[Unit]
Description=devMcp Streamable HTTP endpoint
After=network.target

[Service]
Type=simple
User=devmcp
Group=devmcp
WorkingDirectory=/opt/devmcp
Environment=DEVMCP_CONFIG=/etc/devmcp/global.php
ExecStart=/usr/bin/php -S 127.0.0.1:8765 -t /opt/devmcp/public /opt/devmcp/public/index.php
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/devmcp /var/log/devmcp
UMask=0077

[Install]
WantedBy=multi-user.target
