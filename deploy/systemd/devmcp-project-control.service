[Unit]
Description=devMcp local project service request controller
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=devmcp
WorkingDirectory=/opt/devmcp
ExecStart=/usr/bin/php /opt/devmcp/bin/devmcp-project-service-control
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/devmcp/project-service-requests /run/devmcp-project-results /run/lock
RuntimeDirectory=devmcp-project-results
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0077
