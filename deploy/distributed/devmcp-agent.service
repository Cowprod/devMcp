[Unit]
Description=devMcp distributed agent (enrollment and project jobs)
After=network-online.target zerotier-one.service
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=600
User=devmcp-agent
Group=devmcp-agent
ExecStart=/usr/bin/php /opt/devmcp-agent/bin/distributed-agent.php
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/devmcp
ReadWritePaths=/var/lib/devmcp-agent
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
